GARMIN_USERNAME=
GARMIN_PASSWORD=
DB_FILE=src/db/user_data.db
BACKFILL_DATE=2026-01-01
DOWNSAMPLE_INTERVAL_SECS=300
GARMIN_TOKENSTORE=.garminconnect
GARMIN_RETRY_ATTEMPTS=5
GARMIN_RETRY_MIN_WAIT=2
GARMIN_RETRY_MAX_WAIT=30
SURFACE_ENABLED=1
SURFACE_OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.openstreetmap.fr/api/interpreter
SURFACE_OVERPASS_TIMEOUT_SECS=60
SURFACE_MATCH_RADIUS_M=50
SURFACE_CACHE_ENABLED=1
SURFACE_CACHE_FILE=src/cache/osm_surface_cache.db
SURFACE_CACHE_TILE_DEGREES=0.01
SURFACE_CACHE_VERSION=v1
